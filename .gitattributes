# Binary 3D assets live in Git LFS — see scripts/setup-lfs.mjs.
# `-text` stops git from ever trying line-ending conversion on them.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.bin   filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text

# The Draco/Basis decoders are regenerated by `npm install` and are not
# committed at all (see .gitignore), so they never reach LFS.
